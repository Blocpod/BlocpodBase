{
  "name": "blocpod-base",
  "version": "1.0.0",
  "private": true,
  "description": "Production token issuance and management on Base",
  "engines": {
    "node": "^22.23.4 || ^24.22.1"
  },
  "packageManager": "pnpm@9.4.0",
  "pnpm": {
    "overrides": {
      "@coinbase/cdp-sdk": "1.45.0",
      "@farcaster/miniapp-sdk": "0.1.8",
      "@farcaster/miniapp-wagmi-connector": "1.0.0",
      "@wagmi/core": "2.19.0",
      "jose": "5.10.0",
      "postcss": "8.5.23",
      "sharp": "0.35.0",
      "uuid": "11.1.1",
      "ws": "8.21.0"
    }
  },
  "scripts": {
    "dev": "pnpm --filter @blocpod/web dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "test:contracts": "pnpm --filter @blocpod/contracts-solidity test:ci",
    "security:contracts": "pnpm --filter @blocpod/contracts-solidity check",
    "security:dependencies": "pnpm audit --prod --audit-level high",
    "ci:application": "pnpm --filter '!@blocpod/contracts-solidity' lint && pnpm --filter '!@blocpod/contracts-solidity' typecheck && pnpm --filter '!@blocpod/contracts-solidity' test && pnpm --filter '!@blocpod/contracts-solidity' build",
    "ci": "pnpm ci:application && pnpm security:dependencies && pnpm security:contracts"
  },
  "devDependencies": {
    "prettier": "3.5.3",
    "typescript": "5.8.3"
  }
}
